#!/usr/bin/env bash
set -e

# Example:
#  geckodriver --Version 2>&1
#=> geckodriver 0.10.0
#=> ...... The source is available at....

# Example:
#=> 0.10.0
CMD="geckodriver"
if ${CMD} --Version >/dev/null 2>&1; then
  ${CMD} --Version 2>&1 | grep -Po '(?<=geckodriver )([0-9\.]+)'
else
  ${CMD} --Version #fail and show error
fi
